From d525235fab28a06dd7863dfae02639e6af49b5c1 Mon Sep 17 00:00:00 2001
From: Renn F <rennf93@users.noreply.github.com>
Date: Sat, 24 Oct 2026 04:59:27 +0200
Subject: [PATCH] views: extension window identity for embedders

A CEF Views-hosted Browser is TYPE_POPUP, so the extensions API reported window type popup and windows.getAll/tabs.query with windowType normal skipped it. Report normal for those Browsers only.
---
 patch/patch.cfg                                   |  5 +++++
 .../chrome_browser_extensions_window_type.patch   | 15 +++++++++++++++
 2 files changed, 20 insertions(+)
 create mode 100644 patch/patches/chrome_browser_extensions_window_type.patch

diff --git a/patch/patch.cfg b/patch/patch.cfg
index 837cb8587..ec14595d4 100644
--- a/patch/patch.cfg
+++ b/patch/patch.cfg
@@ -933,5 +933,10 @@ patches = [
     # Noche: the extension post-install dialog anchors to a CEF-hosted Browser
     # instead of creating and showing a separate Chrome window (P3).
     'name': 'chrome_browser_ui_extension_install_in_view',
+  },
+  {
+    # Noche: CEF Views-hosted Browsers report window type 'normal' to the
+    # extensions API (P5).
+    'name': 'chrome_browser_extensions_window_type',
   }
 ]
diff --git a/patch/patches/chrome_browser_extensions_window_type.patch b/patch/patches/chrome_browser_extensions_window_type.patch
new file mode 100644
index 000000000..377ca8406
--- /dev/null
+++ b/patch/patches/chrome_browser_extensions_window_type.patch
@@ -0,0 +1,15 @@
+diff --git chrome/browser/extensions/browser_extension_window_controller.cc chrome/browser/extensions/browser_extension_window_controller.cc
+index b48c0452f31bf4e0456aa27af252a58ec10264f8..442b0518d0eb695ac9aab77ec8c9742e417c2358 100644
+--- chrome/browser/extensions/browser_extension_window_controller.cc
++++ chrome/browser/extensions/browser_extension_window_controller.cc
+@@ -52,6 +52,10 @@
+ #include "chrome/common/chrome_features.h"
+ #endif
+ 
++#if BUILDFLAG(ENABLE_CEF)
++#include "cef/libcef/browser/chrome/browser_delegate.h"
++#endif
++
+ static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
+ 
+ namespace extensions {
-- 
2.56.0

