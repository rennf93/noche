+bool ChromeBrowserHostImpl::DiscardTab() {
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+
+  auto* web_contents = GetWebContents();
+  if (!web_contents || !browser_) {
+    return false;
+  }
+
+  // Without kWebContentsDiscard, Chrome replaces and destroys the WebContents
+  // (TabStripModel::DiscardWebContents) and this CefBrowser would be left
+  // without one. With it, the WebContents is kept and only its renderer goes.
+  if (!base::FeatureList::IsEnabled(features::kWebContentsDiscard)) {
+    return false;
+  }
+
+  // Never discard the tab that is shown: explicit (EXTERNAL) discards are
+  // always allowed by the eligibility policy, so the check is ours.
+  if (browser_->tab_strip_model()->GetActiveWebContents() == web_contents) {
+    return false;
+  }
+
+  auto* lifecycle_unit =
+      resource_coordinator::TabLifecycleUnitSource::GetTabLifecycleUnitExternal(
+          web_contents);
+  if (!lifecycle_unit) {
+    return false;
+  }
+
+  return lifecycle_unit->DiscardTab(
+      ::mojom::LifecycleUnitDiscardReason::EXTERNAL,
+      /*memory_footprint_estimate=*/0);
+}
