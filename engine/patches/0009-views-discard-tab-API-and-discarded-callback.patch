--- a/include/cef_browser.h
+++ b/include/cef_browser.h
@@ -1088,6 +1088,23 @@ class CefBrowserHost : public virtual CefBaseRefCounted {
   ///
   /*--cef(added=experimental)--*/
   virtual void SetAxViewportCollapse(bool enabled) = 0;
+
+  ///
+  /// Discards this browser's tab to free its renderer process and memory, the
+  /// same operation as Memory Saver and urgent memory-pressure discarding. The
+  /// browser, its navigation history, URL, title and favicon stay valid; the
+  /// page is reloaded when the tab becomes the active tab again.
+  /// CefDisplayHandler::OnTabDiscarded is called when the tab becomes
+  /// discarded and again when it is restored. Returns true if the tab was
+  /// discarded. Returns false, and does nothing, if this browser is not a tab of
+  /// a Chrome style browser, if it is the active tab, if it is already
+  /// discarded, or if the WebContentsDiscard feature is not enabled (without it
+  /// Chrome replaces the WebContents, which this browser cannot survive). Enable
+  /// the feature with --enable-features=WebContentsDiscard. This method can
+  /// only be called on the UI thread. Only used with Chrome style.
+  ///
+  /*--cef(added=experimental)--*/
+  virtual bool DiscardTab() = 0;
 #endif
 };
 
diff --git a/include/cef_display_handler.h b/include/cef_display_handler.h
index 5ba804967..47298966a 100644
--- a/include/cef_display_handler.h
+++ b/include/cef_display_handler.h
@@ -203,6 +203,21 @@ class CefDisplayHandler : public virtual CefBaseRefCounted {
     return false;
   }
 #endif
+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+  ///
+  /// Called after |browser|'s tab became discarded (|discarded| is true) or was
+  /// restored (|discarded| is false). A tab is discarded by
+  /// CefBrowserHost::DiscardTab or by Chrome itself (Memory Saver, memory
+  /// pressure). While discarded the tab has no renderer process; it is
+  /// restored, and reloaded, when it becomes the active tab. Called on the UI
+  /// thread, possibly while the tab strip is changing: do not call
+  /// CefBrowserHost::DiscardTab or close browsers from this method. Not called
+  /// after the browser has been destroyed. Only used with Chrome style.
+  ///
+  /*--cef(added=experimental)--*/
+  virtual void OnTabDiscarded(CefRefPtr<CefBrowser> browser, bool discarded) {}
+#endif
 };
 
 #endif  // CEF_INCLUDE_CEF_DISPLAY_HANDLER_H_
