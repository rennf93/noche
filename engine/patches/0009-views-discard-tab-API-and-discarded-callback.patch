+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_TAB_DISCARD_OBSERVER_H_
+#define CEF_LIBCEF_BROWSER_CHROME_TAB_DISCARD_OBSERVER_H_
+#pragma once
+
+#include "chrome/browser/resource_coordinator/lifecycle_unit_observer.h"
+
+// Turns Chrome's tab lifecycle changes into CefDisplayHandler::OnTabDiscarded.
+// Lives on the UI thread. Start() registers with the TabLifecycleUnitSource,
+// Stop() removes the registration; Stop() must run while the browser process
+// (which owns the source) is still alive.
+class CefTabDiscardObserver
+    : public resource_coordinator::LifecycleUnitObserver {
+ public:
+  CefTabDiscardObserver() = default;
+
+  CefTabDiscardObserver(const CefTabDiscardObserver&) = delete;
+  CefTabDiscardObserver& operator=(const CefTabDiscardObserver&) = delete;
+
+  ~CefTabDiscardObserver() override;
+
+  void Start();
+  void Stop();
+
+  // resource_coordinator::LifecycleUnitObserver:
+  void OnLifecycleUnitStateChanged(
+      resource_coordinator::LifecycleUnit* lifecycle_unit,
+      resource_coordinator::LifecycleUnitState last_state) override;
+
+ private:
+  bool started_ = false;
+};
+
+#endif  // CEF_LIBCEF_BROWSER_CHROME_TAB_DISCARD_OBSERVER_H_
