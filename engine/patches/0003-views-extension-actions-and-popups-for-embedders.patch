+  CEF_REQUIRE_VALID_RETURN_VOID();
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  actions.clear();
+  if (auto* controller = GetActionsController()) {
+    controller->GetActions(&actions);
+  }
+}
+
+size_t CefBrowserViewImpl::GetExtensionActionCount() {
+  CEF_REQUIRE_VALID_RETURN(0);
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  auto* controller = GetActionsController();
+  return controller ? controller->GetActions(nullptr) : 0;
+}
+
+void CefBrowserViewImpl::AddExtensionActionObserver(
+    CefRefPtr<CefExtensionActionObserver> observer) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  if (auto* controller = GetActionsController(); controller && observer) {
+    controller->AddObserver(observer);
+  }
+}
