+// Shows the popup of one action as a bubble anchored to a screen rect of the
+// embedder's own Widget (modelled on ExtensionActionDelegateDesktop, minus the
+// Chrome toolbar).
+class CefExtensionActionDelegate : public ExtensionActionDelegate,
+                                   public extensions::ExtensionHostObserver {
+ public:
+  explicit CefExtensionActionDelegate(CefExtensionActionsController* controller)
+      : controller_(controller) {}
+
+  // ExtensionActionDelegate:
+  void AttachToModel(ExtensionActionViewModel* model) override {}
+  void DetachFromModel() override {}
+  void RegisterCommand() override {}
+  void UnregisterCommand() override {}
+  bool IsShowingPopup() const override { return popup_host_ != nullptr; }
+
+  void HidePopup() override {
+    if (!popup_host_) {
+      return;
+    }
+    popup_host_->Close();
+    // Close() may finish later; keep IsShowingPopup() accurate right away.
+    if (popup_host_) {
+      OnPopupClosed();
+    }
+  }
+
+  gfx::NativeView GetPopupNativeView() override {
+    return popup_host_ && popup_host_->view() ? popup_host_->view()->GetNativeView()
+                                              : gfx::NativeView();
+  }
+
+  void TriggerPopup(std::unique_ptr<extensions::ExtensionViewHost> host,
+                    PopupShowAction show_action,
+                    bool by_user,
+                    ShowPopupCallback callback) override {
+    // One popup at a time.
+    controller_->HideAllPopups();
+
+    auto request = controller_->TakePopupRequest();
+    views::Widget* widget = controller_->anchor_widget();
+    if (!request || !widget) {
+      // Not started through CefExtensionAction::Execute(), e.g. a keyboard
+      // command: there is no anchor to show it at.
+      if (callback) {
+        std::move(callback).Run(nullptr);
+      }
+      return;
+    }
+
+    popup_host_ = host.get();
+    popup_host_observation_.Observe(popup_host_.get());
+    ExtensionPopup::ShowPopupAtRect(
+        controller_->browser(), std::move(host), widget, request->screen_rect,
+        views::BubbleBorder::TOP_LEFT, show_action, request->activate,
+        std::move(callback));
+  }
+
+  void ShowContextMenuAsFallback() override {}
+  void CloseExtensionsMenuIfOpen() override {}
+
+  content::WebContents* GetActiveWebContents() const override {
+    return controller_->GetActiveWebContents();
+  }
+
+  // extensions::ExtensionHostObserver:
+  void OnExtensionHostDestroyed(extensions::ExtensionHost* host) override {
+    OnPopupClosed();
+  }
+
+ private:
+  void OnPopupClosed() {
+    popup_host_observation_.Reset();
+    popup_host_ = nullptr;
+  }
+
+  const raw_ptr<CefExtensionActionsController> controller_;
+  raw_ptr<extensions::ExtensionViewHost> popup_host_;
+  base::ScopedObservation<extensions::ExtensionHost,
+                          extensions::ExtensionHostObserver>
+      popup_host_observation_{this};
+};
+
+namespace {
+
+class CefExtensionActionImpl : public CefExtensionAction {
+ public:
+  CefExtensionActionImpl(base::WeakPtr<CefExtensionActionsController> controller,
+                         std::string id)
+      : controller_(std::move(controller)), id_(std::move(id)) {}
+
+  CefString GetId() override { return id_; }
+
+  CefString GetName() override {
+    CEF_REQUIRE_UIT_RETURN(CefString());
+    return controller_ ? controller_->GetName(id_) : CefString();
+  }
+
+  CefString GetTitle(CefRefPtr<CefBrowser> tab) override {
+    CEF_REQUIRE_UIT_RETURN(CefString());
+    return controller_ ? controller_->GetTitle(id_, tab) : CefString();
+  }
+
+  CefRefPtr<CefImage> GetIcon(CefRefPtr<CefBrowser> tab,
+                              int size_dip) override {
+    CEF_REQUIRE_UIT_RETURN(nullptr);
+    return controller_ ? controller_->GetIcon(id_, tab, size_dip) : nullptr;
+  }
+
+  CefString GetBadgeText(CefRefPtr<CefBrowser> tab) override {
+    CEF_REQUIRE_UIT_RETURN(CefString());
+    return controller_ ? controller_->GetBadgeText(id_, tab) : CefString();
+  }
+
+  cef_color_t GetBadgeTextColor(CefRefPtr<CefBrowser> tab) override {
+    CEF_REQUIRE_UIT_RETURN(0);
+    return controller_ ? controller_->GetBadgeTextColor(id_, tab) : 0;
+  }
+
+  cef_color_t GetBadgeBackgroundColor(CefRefPtr<CefBrowser> tab) override {
+    CEF_REQUIRE_UIT_RETURN(0);
+    return controller_ ? controller_->GetBadgeBackgroundColor(id_, tab) : 0;
+  }
+
+  bool IsEnabled(CefRefPtr<CefBrowser> tab) override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    return controller_ && controller_->IsEnabled(id_, tab);
+  }
+
+  bool IsPinned() override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    return controller_ && controller_->IsPinned(id_);
+  }
+
+  bool Execute(const CefRect& anchor_screen_rect, bool activate) override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    return controller_ && controller_->Execute(id_, anchor_screen_rect, activate);
+  }
+
+  bool IsShowingPopup() override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    return controller_ && controller_->IsShowingPopup(id_);
+  }
+
+  void HidePopup() override {
+    CEF_REQUIRE_UIT_RETURN_VOID();
+    if (controller_) {
+      controller_->HidePopup(id_);
+    }
+  }
+
+ private:
+  const base::WeakPtr<CefExtensionActionsController> controller_;
+  const std::string id_;
+
+  IMPLEMENT_REFCOUNTING(CefExtensionActionImpl);
+};
+
+}  // namespace
+
+CefExtensionActionsController::CefExtensionActionsController(
+    BrowserWindowInterface* browser,
+    base::RepeatingCallback<views::Widget*()> anchor_widget)
+    : browser_(browser),
+      anchor_widget_(std::move(anchor_widget)),
+      model_(ToolbarActionsModel::Get(browser->GetProfile())) {
+  if (model_) {
+    model_->AddObserver(this);
+  }
+}
+
+CefExtensionActionsController::~CefExtensionActionsController() {
+  // A view model must not be destroyed while its popup shows.
+  HideAllPopups();
+  view_models_.clear();
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+}
+
+size_t CefExtensionActionsController::GetActions(
+    std::vector<CefRefPtr<CefExtensionAction>>* actions) {
+  size_t count = 0;
+  if (model_) {
+    for (const auto& id : model_->action_ids()) {
+      count++;
+      if (actions) {
+        actions->push_back(MakeAction(id));
+      }
+    }
+  }
+  return count;
+}
+
+void CefExtensionActionsController::AddObserver(
+    CefRefPtr<CefExtensionActionObserver> observer) {
+  observers_.push_back(observer);
+  // OnToolbarModelInitialized() only reaches observers added before the model
+  // was ready, so tell a late observer about the existing actions.
+  if (model_ && model_->actions_initialized()) {
+    for (const auto& id : model_->action_ids()) {
+      CEF_POST_TASK(CEF_UIT,
+                    base::BindOnce(&CefExtensionActionsController::NotifyAddedTo,
+                                   weak_ptr_factory_.GetWeakPtr(), observer, id));
+    }
+  }
+}
+
+void CefExtensionActionsController::NotifyAddedTo(
+    CefRefPtr<CefExtensionActionObserver> observer,
+    std::string id) {
+  observer->OnActionAdded(MakeAction(id));
+}
+
+CefRefPtr<CefExtensionAction> CefExtensionActionsController::MakeAction(
+    const std::string& id) {
+  return new CefExtensionActionImpl(weak_ptr_factory_.GetWeakPtr(), id);
+}
+
+content::WebContents* CefExtensionActionsController::GetActiveWebContents()
+    const {
+  return browser_->GetTabStripModel()->GetActiveWebContents();
+}
+
+content::WebContents* CefExtensionActionsController::GetContents(
+    CefRefPtr<CefBrowser> tab) {
+  if (tab) {
+    auto host = CefBrowserHostBase::FromBrowser(tab);
+    return host ? host->GetWebContents() : nullptr;
+  }
+  return GetActiveWebContents();
+}
+
+ExtensionActionViewModel* CefExtensionActionsController::GetViewModel(
+    const std::string& id) {
+  if (!model_ || !model_->HasAction(id)) {
+    return nullptr;
+  }
+  auto it = view_models_.find(id);
+  if (it == view_models_.end()) {
+    // Create() requires an enabled extension with an action.
+    auto* registry = extensions::ExtensionRegistry::Get(browser_->GetProfile());
+    if (!registry->enabled_extensions().GetByID(id)) {
+      return nullptr;
+    }
+    auto vm = ExtensionActionViewModel::Create(
+        id, browser_, std::make_unique<CefExtensionActionDelegate>(this));
+    // The icon (and so the badge) can load after the view model exists.
+    auto subscription = vm->RegisterIconUpdateObserver(base::BindRepeating(
+        &CefExtensionActionsController::OnToolbarActionUpdated,
+        base::Unretained(this), id));
+    it = view_models_.emplace(id, ViewModelEntry{std::move(vm), std::move(subscription)})
+             .first;
+  }
+  return it->second.view_model.get();
+}
+
+extensions::ExtensionAction* CefExtensionActionsController::GetAction(
+    const std::string& id) {
+  auto* profile = browser_->GetProfile();
+  auto* extension = extensions::ExtensionRegistry::Get(profile)
+                        ->enabled_extensions()
+                        .GetByID(id);
+  return extension ? extensions::ExtensionActionManager::Get(profile)
+                         ->GetExtensionAction(*extension)
+                   : nullptr;
+}
+
+CefString CefExtensionActionsController::GetName(const std::string& id) {
+  auto* vm = GetViewModel(id);
+  return vm ? CefString(base::UTF16ToUTF8(vm->GetActionName())) : CefString();
+}
+
+CefString CefExtensionActionsController::GetTitle(const std::string& id,
+                                                  CefRefPtr<CefBrowser> tab) {
+  auto* vm = GetViewModel(id);
+  auto* contents = GetContents(tab);
+  return vm && contents
+             ? CefString(base::UTF16ToUTF8(vm->GetActionTitle(contents)))
+             : CefString();
+}
+
+CefRefPtr<CefImage> CefExtensionActionsController::GetIcon(
+    const std::string& id,
+    CefRefPtr<CefBrowser> tab,
+    int size_dip) {
+  auto* vm = GetViewModel(id);
+  auto* contents = GetContents(tab);
+  if (!vm || !contents || size_dip <= 0) {
+    return nullptr;
+  }
+  ui::ImageModel model = vm->GetIcon(contents, gfx::Size(size_dip, size_dip));
+  if (!model.IsImage()) {
+    return nullptr;
+  }
+  // The icon is drawn lazily per scale factor: draw both now so CefImage has
+  // them (GetAsBitmap() may be called later, on another thread).
+  gfx::ImageSkia skia = model.GetImage().AsImageSkia();
+  skia.GetRepresentation(1.0f);
+  skia.GetRepresentation(2.0f);
+  return new CefImageImpl(skia);
+}
+
+CefString CefExtensionActionsController::GetBadgeText(
+    const std::string& id,
+    CefRefPtr<CefBrowser> tab) {
+  auto* action = GetAction(id);
+  auto* contents = GetContents(tab);
+  return action ? CefString(action->GetDisplayBadgeText(
+                      extensions::ExtensionTabUtil::GetTabId(contents)))
+                : CefString();
+}
+
+cef_color_t CefExtensionActionsController::GetBadgeTextColor(
+    const std::string& id,
+    CefRefPtr<CefBrowser> tab) {
+  auto* action = GetAction(id);
+  return action ? action->GetBadgeTextColor(
+                      extensions::ExtensionTabUtil::GetTabId(GetContents(tab)))
+                : 0;
+}
+
+cef_color_t CefExtensionActionsController::GetBadgeBackgroundColor(
+    const std::string& id,
+    CefRefPtr<CefBrowser> tab) {
+  auto* action = GetAction(id);
+  return action ? action->GetBadgeBackgroundColor(
+                      extensions::ExtensionTabUtil::GetTabId(GetContents(tab)))
+                : 0;
+}
+
+bool CefExtensionActionsController::IsEnabled(const std::string& id,
+                                              CefRefPtr<CefBrowser> tab) {
+  auto* vm = GetViewModel(id);
+  return vm && vm->IsEnabled(GetContents(tab));
+}
+
+bool CefExtensionActionsController::IsPinned(const std::string& id) {
+  return model_ && model_->IsActionPinned(id);
+}
+
+bool CefExtensionActionsController::Execute(const std::string& id,
+                                            const CefRect& anchor_screen_rect,
+                                            bool activate) {
+  auto* vm = GetViewModel(id);
+  if (!vm || !vm->IsEnabled(GetActiveWebContents())) {
+    return false;
+  }
+  popup_request_ = PopupRequest{
+      gfx::Rect(anchor_screen_rect.x, anchor_screen_rect.y,
+                anchor_screen_rect.width, anchor_screen_rect.height),
+      activate};
+  vm->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  popup_request_.reset();
+  return true;
+}
+
+bool CefExtensionActionsController::IsShowingPopup(const std::string& id) {
+  auto it = view_models_.find(id);
+  return it != view_models_.end() && it->second.view_model->IsShowingPopup();
+}
+
+void CefExtensionActionsController::HidePopup(const std::string& id) {
+  auto it = view_models_.find(id);
+  if (it != view_models_.end()) {
+    it->second.view_model->HidePopup();
+  }
+}
+
+void CefExtensionActionsController::HideAllPopups() {
+  for (auto& [id, entry] : view_models_) {
+    entry.view_model->HidePopup();
+  }
+}
+
+std::optional<CefExtensionActionsController::PopupRequest>
+CefExtensionActionsController::TakePopupRequest() {
+  auto request = std::move(popup_request_);
+  popup_request_.reset();
+  return request;
+}
+
+void CefExtensionActionsController::OnToolbarActionAdded(
+    const ToolbarActionsModel::ActionId& id) {
+  CEF_POST_TASK(CEF_UIT,
+                base::BindOnce(&CefExtensionActionsController::NotifyAdded,
+                               weak_ptr_factory_.GetWeakPtr(), id));
+}
+
+void CefExtensionActionsController::OnToolbarActionRemoved(
+    const ToolbarActionsModel::ActionId& id) {
+  auto it = view_models_.find(id);
+  if (it != view_models_.end()) {
+    it->second.view_model->HidePopup();
+    view_models_.erase(it);
+  }
+  CEF_POST_TASK(CEF_UIT,
+                base::BindOnce(&CefExtensionActionsController::NotifyRemoved,
+                               weak_ptr_factory_.GetWeakPtr(), id));
+}
+
+void CefExtensionActionsController::OnToolbarActionUpdated(
+    const ToolbarActionsModel::ActionId& id) {
+  CEF_POST_TASK(CEF_UIT,
+                base::BindOnce(&CefExtensionActionsController::NotifyUpdated,
+                               weak_ptr_factory_.GetWeakPtr(), id));
+}
+
+void CefExtensionActionsController::OnToolbarModelInitialized() {
+  // Each action that existed before the model was ready is reported as added.
+  for (const auto& id : model_->action_ids()) {
+    OnToolbarActionAdded(id);
+  }
+}
+
+void CefExtensionActionsController::OnToolbarPinnedActionsChanged() {
+  CEF_POST_TASK(
+      CEF_UIT,
+      base::BindOnce(&CefExtensionActionsController::NotifyPinnedChanged,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void CefExtensionActionsController::OnToolbarActionsModelShutdown() {
+  HideAllPopups();
+  view_models_.clear();
+  model_->RemoveObserver(this);
+  model_ = nullptr;
+}
+
+void CefExtensionActionsController::NotifyAdded(std::string id) {
+  auto observers = observers_;
+  for (auto& o : observers) {
+    o->OnActionAdded(MakeAction(id));
+  }
+}
+
+void CefExtensionActionsController::NotifyRemoved(std::string id) {
+  auto observers = observers_;
+  for (auto& o : observers) {
+    o->OnActionRemoved(id);
+  }
+}
+
+void CefExtensionActionsController::NotifyUpdated(std::string id) {
+  auto observers = observers_;
+  for (auto& o : observers) {
+    o->OnActionUpdated(MakeAction(id));
+  }
+}
+
+void CefExtensionActionsController::NotifyPinnedChanged() {
+  auto observers = observers_;
+  for (auto& o : observers) {
+    o->OnPinnedActionsChanged();
+  }
+}
