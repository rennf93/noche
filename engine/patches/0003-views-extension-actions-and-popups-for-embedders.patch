+// Bridges ToolbarActionsModel and ExtensionActionViewModel to the
+// CefExtensionAction API for one Views-hosted Chrome style Browser. Owned by
+// CefBrowserViewImpl. UI thread only.
+class CefExtensionActionsController : public ToolbarActionsModel::Observer {
+ public:
+  // |anchor_widget| returns the CEF Widget the popup bubble is parented to.
+  CefExtensionActionsController(
+      BrowserWindowInterface* browser,
+      base::RepeatingCallback<views::Widget*()> anchor_widget);
+  ~CefExtensionActionsController() override;
+
+  size_t GetActions(std::vector<CefRefPtr<CefExtensionAction>>* actions);
+  void AddObserver(CefRefPtr<CefExtensionActionObserver> observer);
+
+  // CefExtensionAction implementation, keyed by extension id. |tab| NULL means
+  // the active tab.
+  CefString GetName(const std::string& id);
+  CefString GetTitle(const std::string& id, CefRefPtr<CefBrowser> tab);
+  CefRefPtr<CefImage> GetIcon(const std::string& id,
+                              CefRefPtr<CefBrowser> tab,
+                              int size_dip);
+  CefString GetBadgeText(const std::string& id, CefRefPtr<CefBrowser> tab);
+  cef_color_t GetBadgeTextColor(const std::string& id,
+                                CefRefPtr<CefBrowser> tab);
+  cef_color_t GetBadgeBackgroundColor(const std::string& id,
+                                      CefRefPtr<CefBrowser> tab);
+  bool IsEnabled(const std::string& id, CefRefPtr<CefBrowser> tab);
+  bool IsPinned(const std::string& id);
+  bool Execute(const std::string& id,
+               const CefRect& anchor_screen_rect,
+               bool activate);
+  bool IsShowingPopup(const std::string& id);
+  void HidePopup(const std::string& id);
+
+  // Used by CefExtensionActionDelegate.
+  BrowserWindowInterface* browser() const { return browser_; }
+  views::Widget* anchor_widget() const { return anchor_widget_.Run(); }
+  content::WebContents* GetActiveWebContents() const;
+  struct PopupRequest {
+    gfx::Rect screen_rect;
+    bool activate;
+  };
+  // Set by Execute() for the TriggerPopup() call it causes; consumed there.
+  std::optional<PopupRequest> TakePopupRequest();
+  void HideAllPopups();
+
+ private:
+  // ToolbarActionsModel::Observer:
+  void OnToolbarActionAdded(const ToolbarActionsModel::ActionId& id) override;
+  void OnToolbarActionRemoved(const ToolbarActionsModel::ActionId& id) override;
+  void OnToolbarActionUpdated(const ToolbarActionsModel::ActionId& id) override;
+  void OnToolbarModelInitialized() override;
+  void OnToolbarPinnedActionsChanged() override;
+  void OnToolbarActionsModelShutdown() override;
+
+  ExtensionActionViewModel* GetViewModel(const std::string& id);
+  extensions::ExtensionAction* GetAction(const std::string& id);
+  content::WebContents* GetContents(CefRefPtr<CefBrowser> tab);
+  CefRefPtr<CefExtensionAction> MakeAction(const std::string& id);
+
+  // Observer callbacks run from a posted task: calling out synchronously from
+  // a Chromium observer notification can re-enter Chromium.
+  void NotifyAdded(std::string id);
+  void NotifyAddedTo(CefRefPtr<CefExtensionActionObserver> observer,
+                     std::string id);
+  void NotifyRemoved(std::string id);
+  void NotifyUpdated(std::string id);
+  void NotifyPinnedChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const base::RepeatingCallback<views::Widget*()> anchor_widget_;
+  raw_ptr<ToolbarActionsModel> model_;
+  struct ViewModelEntry {
+    std::unique_ptr<ExtensionActionViewModel> view_model;
+    base::CallbackListSubscription icon_subscription;
+  };
+  std::map<std::string, ViewModelEntry> view_models_;
+  std::vector<CefRefPtr<CefExtensionActionObserver>> observers_;
+  std::optional<PopupRequest> popup_request_;
+
+  base::WeakPtrFactory<CefExtensionActionsController> weak_ptr_factory_{this};
+};
