+///
+/// One extension toolbar action (chrome.action) of a Chrome style
+/// CefBrowserView, for an embedder that draws its own toolbar. Obtained from
+/// CefBrowserView::GetExtensionActions or a CefExtensionActionObserver. All
+/// methods must be called on the browser process UI thread. Methods taking a
+/// |tab| use the BrowserView's active tab when |tab| is NULL.
+///
+/*--cef(source=library,added=experimental)--*/
+class CefExtensionAction : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Returns the extension id.
+  ///
+  /*--cef()--*/
+  virtual CefString GetId() = 0;
+
+  ///
+  /// Returns the extension name.
+  ///
+  /*--cef()--*/
+  virtual CefString GetName() = 0;
+
+  ///
+  /// Returns the action title for |tab| (chrome.action.setTitle).
+  ///
+  /*--cef(optional_param=tab)--*/
+  virtual CefString GetTitle(CefRefPtr<CefBrowser> tab) = 0;
+
+  ///
+  /// Returns the action icon for |tab| at |size_dip| x |size_dip|, with the
+  /// badge already drawn into it, or NULL. Representations for scale factors 1
+  /// and 2 are present. The icon can load asynchronously, so an icon that is
+  /// still fully transparent is replaced later: CefExtensionActionObserver::
+  /// OnActionUpdated is called.
+  ///
+  /*--cef(optional_param=tab)--*/
+  virtual CefRefPtr<CefImage> GetIcon(CefRefPtr<CefBrowser> tab,
+                                      int size_dip) = 0;
+
+  ///
+  /// Returns the badge text for |tab| (chrome.action.setBadgeText), or empty.
+  ///
+  /*--cef(optional_param=tab)--*/
+  virtual CefString GetBadgeText(CefRefPtr<CefBrowser> tab) = 0;
+
+  ///
+  /// Returns the badge text color for |tab| as ARGB.
+  ///
+  /*--cef(optional_param=tab,default_retval=0)--*/
+  virtual cef_color_t GetBadgeTextColor(CefRefPtr<CefBrowser> tab) = 0;
+
+  ///
+  /// Returns the badge background color for |tab| as ARGB.
+  ///
+  /*--cef(optional_param=tab,default_retval=0)--*/
+  virtual cef_color_t GetBadgeBackgroundColor(CefRefPtr<CefBrowser> tab) = 0;
+
+  ///
+  /// Returns true if the action is enabled for |tab|.
+  ///
+  /*--cef(optional_param=tab)--*/
+  virtual bool IsEnabled(CefRefPtr<CefBrowser> tab) = 0;
+
+  ///
+  /// Returns true if the user pinned the action to the toolbar.
+  ///
+  /*--cef()--*/
+  virtual bool IsPinned() = 0;
+
+  ///
+  /// Runs the action on the active tab as if the user clicked it: chrome.action.
+  /// onClicked fires, or the popup opens when the action has one. A popup is a
+  /// Chrome bubble anchored below |anchor_screen_rect| (DIP, screen
+  /// coordinates, origin at the top left of the primary display) as a child of
+  /// the BrowserView's window; it closes when the active tab changes or the
+  /// BrowserView's window is activated. With |activate| true the popup takes
+  /// focus and may activate the application. With false it is shown inactive:
+  /// the application is not activated and the popup never becomes the key
+  /// window. Returns true if the action was run, which does not mean a popup
+  /// opened: an action without a popup fires onClicked instead, and Chrome can
+  /// still withhold the popup (host permission). Use IsShowingPopup() to see
+  /// whether one opened. Returns false if the action is disabled or invalid.
+  ///
+  /*--cef()--*/
+  virtual bool Execute(const CefRect& anchor_screen_rect, bool activate) = 0;
+
+  ///
+  /// Returns true while this action's popup is showing.
+  ///
+  /*--cef()--*/
+  virtual bool IsShowingPopup() = 0;
+
+  ///
+  /// Closes this action's popup if it is showing.
+  ///
+  /*--cef()--*/
+  virtual void HidePopup() = 0;
+};
+
+///
+/// Implement this interface to be told about extension action changes. Add it
+/// with CefBrowserView::AddExtensionActionObserver. Methods are called
+/// asynchronously on the browser process UI thread, so they may call back into
+/// the API.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefExtensionActionObserver : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Called for an action that appeared. Each existing action is reported once
+  /// to a newly added observer when the toolbar model is ready, or as soon as
+  /// it becomes ready (so an observer added late still hears about them).
+  ///
+  /*--cef()--*/
+  virtual void OnActionAdded(CefRefPtr<CefExtensionAction> action) {}
+
+  ///
+  /// Called when the extension with |extension_id| was removed or unloaded.
+  ///
+  /*--cef()--*/
+  virtual void OnActionRemoved(const CefString& extension_id) {}
+
+  ///
+  /// Called when an action's icon, title, badge or state changed.
+  ///
+  /*--cef()--*/
+  virtual void OnActionUpdated(CefRefPtr<CefExtensionAction> action) {}
+
+  ///
+  /// Called when the set or order of pinned actions changed.
+  ///
+  /*--cef()--*/
+  virtual void OnPinnedActionsChanged() {}
+};
+
+#endif  // CEF_API_ADDED(CEF_EXPERIMENTAL)
+
+#endif  // CEF_INCLUDE_CEF_EXTENSION_ACTION_H_
