+CefExtensionActionsController* CefBrowserViewImpl::GetActionsController() {
+  if (is_alloy_style_ || !browser_ || !root_view()) {
+    return nullptr;
+  }
+  if (!actions_) {
+    auto* browser = chrome_browser_view()->browser();
+    if (!browser) {
+      return nullptr;
+    }
+    actions_ = std::make_unique<CefExtensionActionsController>(
+        browser, base::BindRepeating(&CefBrowserViewImpl::GetAnchorWidget,
+                                     base::Unretained(this)));
+  }
+  return actions_.get();
