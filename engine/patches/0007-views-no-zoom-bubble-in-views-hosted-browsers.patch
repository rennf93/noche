From 69baad9fc78aded62a0276d3636749f449cf330e Mon Sep 17 00:00:00 2001
From: Renn F <rennf93@users.noreply.github.com>
Date: Sat, 24 Oct 2026 21:07:29 +0200
Subject: [PATCH] views: no zoom bubble in views-hosted browsers

---
 patch/patch.cfg                               |  4 +++
 .../chrome_browser_ui_zoom_bubble.patch       | 32 +++++++++++++++++++
 2 files changed, 36 insertions(+)
 create mode 100644 patch/patches/chrome_browser_ui_zoom_bubble.patch

diff --git a/patch/patch.cfg b/patch/patch.cfg
index ec14595d4..75f5886c6 100644
--- a/patch/patch.cfg
+++ b/patch/patch.cfg
@@ -938,5 +938,9 @@ patches = [
     # Noche: CEF Views-hosted Browsers report window type 'normal' to the
     # extensions API (P5).
     'name': 'chrome_browser_extensions_window_type',
+  },
+  {
+    # Noche: no zoom bubble for CEF Views-hosted Browsers (zoom still works).
+    'name': 'chrome_browser_ui_zoom_bubble',
   }
 ]
diff --git a/patch/patches/chrome_browser_ui_zoom_bubble.patch b/patch/patches/chrome_browser_ui_zoom_bubble.patch
new file mode 100644
index 000000000..e2e03ec7a
--- /dev/null
+++ b/patch/patches/chrome_browser_ui_zoom_bubble.patch
@@ -0,0 +1,32 @@
+diff --git chrome/browser/ui/views/zoom/zoom_view_controller.cc chrome/browser/ui/views/zoom/zoom_view_controller.cc
+index c9957bb11ce5ebf1f4b226084cbb41b704afdd25..953ea4120eef4d2e4ff99849286e495ccdf2ebad 100644
+--- chrome/browser/ui/views/zoom/zoom_view_controller.cc
++++ chrome/browser/ui/views/zoom/zoom_view_controller.cc
+@@ -28,6 +28,10 @@
+ #include "ui/base/l10n/l10n_util.h"
+ #include "ui/base/ui_base_features.h"
+ 
++#if BUILDFLAG(ENABLE_CEF)
++#include "cef/libcef/browser/chrome/browser_delegate.h"
++#endif
++
+ namespace zoom {
+ 
+ ZoomViewController::ZoomViewController(
+@@ -108,6 +112,16 @@ void ZoomViewController::UpdatePageActionIconVisibility(
+ 
+ void ZoomViewController::UpdateBubbleVisibility(bool prefer_to_show_bubble,
+                                                 bool from_user_gesture) {
++#if BUILDFLAG(ENABLE_CEF)
++  // Noche: a CEF views-hosted Browser has no location bar to anchor the zoom
++  // bubble to, so it would flash a window at the top-left. Zoom itself is
++  // unaffected; only the bubble is skipped.
++  if (auto* cef_delegate =
++          tab_interface_->GetBrowserWindowInterface()->cef_delegate();
++      cef_delegate && cef_delegate->IsViewsHosted()) {
++    return;
++  }
++#endif
+   zoom::ZoomController* zoom_controller =
+       zoom::ZoomController::FromWebContents(GetWebContents());
+   CHECK(zoom_controller);
-- 
2.56.0

