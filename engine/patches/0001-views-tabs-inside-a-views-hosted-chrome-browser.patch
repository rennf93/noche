+CefRefPtr<CefBrowser> CefBrowserViewImpl::AddTab(
+    const CefString& url,
+    CefRefPtr<CefClient> client,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info,
+    bool activate) {
+  CEF_REQUIRE_VALID_RETURN(nullptr);
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+
+  // |client|, |settings| and |extra_info| are ignored until per-tab client
+  // support is added.
+  if (is_alloy_style_ || !browser_ || !root_view()) {
+    return nullptr;
+  }
+
+  GURL gurl = url_util::MakeGURL(url, /*fixup=*/true);
+  if (gurl.is_empty()) {
+    // Same as ChromeBrowserHostImpl::Create(): don't navigate at all.
+    gurl = GURL("chrome://ignore/");
+  }
+
+  // Goes through the navigator, which creates the WebContents and indirectly
+  // the ChromeBrowserHostImpl (see ChromeBrowserDelegate::SetAsDelegate).
+  auto* contents = chrome::AddAndReturnTabAt(
+      chrome_browser_view()->browser(), gurl, TabStripModel::kNoTab, activate);
+  if (!contents) {
+    return nullptr;
+  }
+  return ChromeBrowserHostImpl::GetBrowserForContents(contents);
+}
+
+void CefBrowserViewImpl::SetActiveTab(CefRefPtr<CefBrowser> tab) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+
+  auto host = CefBrowserHostBase::FromBrowser(tab);
+  if (is_alloy_style_ || !host || !host->GetWebContents() || !root_view() ||
+      std::find(tabs_.begin(), tabs_.end(), host) == tabs_.end()) {
+    return;
+  }
+
+  // OnActiveTabChanged() follows from the TabStripModel notification.
+  auto* model = chrome_browser_view()->browser()->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(host->GetWebContents());
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index);
+  }
+}
+
+CefRefPtr<CefBrowser> CefBrowserViewImpl::GetActiveTab() {
+  CEF_REQUIRE_VALID_RETURN(nullptr);
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  return browser_;
+}
+
+size_t CefBrowserViewImpl::GetTabCount() {
+  CEF_REQUIRE_VALID_RETURN(0);
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  return is_alloy_style_ ? (browser_ ? 1 : 0) : tabs_.size();
+}
+
+void CefBrowserViewImpl::GetTabs(std::vector<CefRefPtr<CefBrowser>>& tabs) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  CEF_API_REQUIRE_ADDED(CEF_EXPERIMENTAL);
+  tabs.clear();
+  if (is_alloy_style_) {
+    if (browser_) {
+      tabs.push_back(browser_);
+    }
+    return;
+  }
+
+  // Tab strip order, which can differ from creation order.
+  if (root_view() && chrome_browser_view()->browser()) {
+    auto* model = chrome_browser_view()->browser()->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      if (auto host = ChromeBrowserHostImpl::GetBrowserForContents(
+              model->GetWebContentsAt(i))) {
+        tabs.push_back(host);
+      }
+    }
+  }
+  if (tabs.empty()) {
+    tabs.assign(tabs_.begin(), tabs_.end());
+  }
+}
+
+void CefBrowserViewImpl::OnTabInserted(content::WebContents* contents,
+                                       bool active) {
+  // The first tab is reported through OnBrowserCreated() only.
+  if (tabs_.size() <= 1 || !delegate() || !CEF_API_IS_ADDED(CEF_EXPERIMENTAL)) {
+    return;
+  }
+  if (auto host = ChromeBrowserHostImpl::GetBrowserForContents(contents)) {
+    // Not synchronous: TabStripModel CHECKs against re-entrant calls, so a
+    // delegate calling AddTab() or SetActiveTab() from here would crash.
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&CefBrowserViewImpl::NotifyTabAdded,
+                                 weak_ptr_factory_.GetWeakPtr(),
+                                 CefRefPtr<CefBrowserHostBase>(host), active));
+  }
+}
+
+void CefBrowserViewImpl::OnActiveTabChanged(content::WebContents* old_contents,
+                                            content::WebContents* new_contents) {
+  if (!new_contents) {
+    return;
+  }
+  auto active = ChromeBrowserHostImpl::GetBrowserForContents(new_contents);
+  if (!active) {
+    return;
+  }
+
+  CefRefPtr<CefBrowserHostBase> previous;
+  if (old_contents) {
+    previous = ChromeBrowserHostImpl::GetBrowserForContents(old_contents);
+  }
+
+  // GetActiveTab() reflects the change right away; the delegate call is async.
+  browser_ = active;
+
+  // The very first activation has no previous tab and is covered by
+  // OnBrowserCreated().
+  if (previous && delegate() && CEF_API_IS_ADDED(CEF_EXPERIMENTAL)) {
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&CefBrowserViewImpl::NotifyActiveTabChanged,
+                                 weak_ptr_factory_.GetWeakPtr(), previous,
+                                 CefRefPtr<CefBrowserHostBase>(active)));
+  }
+}
+
+void CefBrowserViewImpl::NotifyTabAdded(CefRefPtr<CefBrowserHostBase> tab,
+                                        bool active) {
+  if (delegate() && std::find(tabs_.begin(), tabs_.end(), tab) != tabs_.end()) {
+    delegate()->OnTabAdded(this, tab, active);
+  }
+}
+
+void CefBrowserViewImpl::NotifyActiveTabChanged(
+    CefRefPtr<CefBrowserHostBase> previous,
+    CefRefPtr<CefBrowserHostBase> active) {
+  auto live = [this](const CefRefPtr<CefBrowserHostBase>& t) {
+    return std::find(tabs_.begin(), tabs_.end(), t) != tabs_.end();
+  };
+  if (!delegate() || !live(active)) {
+    return;
+  }
+  // A previous tab that was closed before this task ran is reported as NULL.
+  delegate()->OnActiveTabChanged(this, live(previous) ? previous : nullptr,
+                                 active);
+}
