+void ChromeBrowserView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ParentClass::OnTabStripModelChanged(tab_strip_model, change, selection);
+
+  if (destroyed_) {
+    return;
+  }
+
+  if (change.type() == TabStripModelChange::kInserted) {
+    for (const auto& tab : change.GetInsert()->contents) {
+      cef_browser_view_->OnTabInserted(tab.contents,
+                                       tab.contents == selection.new_contents);
+    }
+  }
+
+  if (selection.active_tab_changed()) {
+    cef_browser_view_->OnActiveTabChanged(selection.old_contents,
+                                          selection.new_contents);
+  }
+}
