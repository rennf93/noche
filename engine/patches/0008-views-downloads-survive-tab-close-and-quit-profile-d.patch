+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+  ///
+  /// Sets the download handler for all browsers that share this request
+  /// context's profile, for downloads that have no live browser: a download
+  /// whose tab was closed, and downloads restored from history at startup. For
+  /// those, CefDownloadHandler::OnDownloadUpdated is called with a NULL
+  /// browser. Items that exist when this method is called are announced
+  /// immediately through OnDownloadUpdated. Downloads that have a live browser
+  /// keep going to that browser's client. Pass NULL to remove the handler. Must
+  /// be called on the browser process UI thread.
+  ///
+  /*--cef(added=experimental,optional_param=handler)--*/
+  virtual void SetDownloadHandler(CefRefPtr<CefDownloadHandler> handler) = 0;
+#endif
 };
 
 #endif  // CEF_INCLUDE_CEF_REQUEST_CONTEXT_H_
