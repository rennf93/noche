   CefRefPtr<CefBrowserHostBase> browser = GetOrAssociateBrowser(item);
+  if (!browser && item->GetDownloadCreationType() ==
+                      DownloadItem::TYPE_HISTORY_IMPORT) {
+    // Noche: an item restored from history has no WebContents and is not a
+    // rejected download. Cancelling it would destroy the partial file of an
+    // interrupted download, so keep it and announce it to the profile handler.
+    AssociateWithoutBrowser(item);
+    NotifyProfileHandler(item);
+    return;
+  }
   if (!browser) {
     // If the download is rejected (e.g. ALT+click on an invalid protocol link)
     // then an "interrupted" download will be started via DownloadManagerImpl::
@@ -407,6 +492,21 @@ bool CefDownloadManagerDelegateImpl::DetermineDownloadTarget(
   // from either method.
   CefRefPtr<CefBrowserHostBase> browser = GetOrAssociateBrowser(item);
   if (!browser) {
+    // Noche: an item restored from history (or whose tab is gone) that already
+    // has a target keeps it. Returning false here made Chrome's target
+    // determiner re-pick the default Downloads directory on resume.
+    if (!item->GetTargetFilePath().empty()) {
+      download::DownloadTargetInfo target_info;
+      target_info.target_path = item->GetTargetFilePath();
+      target_info.intermediate_path = item->GetFullPath().empty()
+                                          ? item->GetTargetFilePath()
+                                          : item->GetFullPath();
+      target_info.danger_type = item->GetDangerType();
+      target_info.target_disposition = item->GetTargetDisposition();
+      target_info.insecure_download_status = item->GetInsecureDownloadStatus();
+      std::move(*callback).Run(std::move(target_info));
+      return true;
+    }
     return false;
   }
 
@@ -473,8 +573,9 @@ void CefDownloadManagerDelegateImpl::OnBrowserDestroyed(
   for (auto& [item, item_browser] : item_browser_map_) {
     if (item_browser == browser) {
       // Don't call back into browsers that have been destroyed. We're not
-      // canceling the download so it will continue silently until it completes
-      // or until the associated browser context is destroyed.
+      // canceling the download so it will continue until it completes or until
+      // the associated browser context is destroyed. Updates now go to the
+      // profile download handler, if one is set.
       item_browser = nullptr;
     }
   }
