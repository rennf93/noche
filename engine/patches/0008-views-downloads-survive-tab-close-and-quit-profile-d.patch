+CefRefPtr<CefDownloadHandler> GetProfileDownloadHandler(DownloadItem* item) {
+  auto* context = content::DownloadItemUtils::GetBrowserContext(item);
+  auto* cef_context =
+      context ? CefBrowserContext::FromBrowserContext(context) : nullptr;
+  return cef_context ? cef_context->download_handler() : nullptr;
