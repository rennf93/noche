+void CefBrowserContext::SetDownloadHandler(
+    CefRefPtr<CefDownloadHandler> handler) {
+  CEF_REQUIRE_UIT();
+#if DCHECK_IS_ON()
+  DCHECK(!is_shutdown_);
+#endif
+  download_handler_ = handler;
+  if (!handler) {
+    return;
+  }
+
+  // Make sure the download manager exists so that downloads restored from
+  // history reach the handler without waiting for a new download.
+  AsBrowserContext()->GetDownloadManager();
+  CefDownloadManagerDelegateImpl::AnnounceItemsWithoutBrowser(
+      AsBrowserContext());
+}
