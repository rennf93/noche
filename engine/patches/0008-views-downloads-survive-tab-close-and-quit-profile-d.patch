   /// methods that modify state (like LoadURL, SendProcessMessage, etc.) if the
   /// frame is invalid.
   ///
+  /// A request that was kept alive as a download after its browser was closed
+  /// is not reported as aborted. Its single completion arrives later with the
+  /// original |browser| and |frame| (IsValid() is false by then). A kept
+  /// request that is cancelled because its request context is destroyed gets
+  /// no completion.
+  ///
   /*--cef(optional_param=browser,optional_param=frame)--*/
   virtual void OnResourceLoadComplete(CefRefPtr<CefBrowser> browser,
                                       CefRefPtr<CefFrame> frame,
