+// static
+void CefDownloadManagerDelegateImpl::AnnounceItemsWithoutBrowser(
+    content::BrowserContext* context) {
+  CEF_REQUIRE_UIT();
+  for (auto* delegate : Instances()) {
+    if (!delegate->manager_ ||
+        delegate->manager_->GetBrowserContext() != context) {
+      continue;
+    }
+    // Copy first: a handler may trigger changes to the map.
+    std::vector<raw_ptr<DownloadItem>> items;
+    for (const auto& [item, browser] : delegate->item_browser_map_) {
+      if (!browser) {
+        items.push_back(item);
+      }
+    }
+    for (DownloadItem* item : items) {
+      delegate->NotifyProfileHandler(item);
+    }
+  }
+}
+
 void CefDownloadManagerDelegateImpl::OnDownloadUpdated(DownloadItem* download) {
   CefRefPtr<CefBrowserHostBase> browser = GetBrowser(download);
   CefRefPtr<CefDownloadHandler> handler;
   if (browser.get()) {
     handler = GetDownloadHandler(browser);
+  } else {
+    // Noche: no live browser (tab closed, or restored from history).
+    handler = GetProfileDownloadHandler(download);
   }
 
   if (handler.get()) {
@@ -345,6 +405,22 @@ void CefDownloadManagerDelegateImpl::OnDownloadUpdated(DownloadItem* download) {
   }
 }
 
+void CefDownloadManagerDelegateImpl::NotifyProfileHandler(DownloadItem* item) {
+  if (!GetBrowser(item)) {
+    OnDownloadUpdated(item);
+  }
+}
+
+void CefDownloadManagerDelegateImpl::AssociateWithoutBrowser(
+    DownloadItem* item) {
+  if (item_browser_map_.find(item) != item_browser_map_.end()) {
+    return;
+  }
+  // OnDownloadDestroyed expects every observed item to be in the map.
+  item->AddObserver(this);
+  item_browser_map_.insert(std::make_pair(item, nullptr));
+}
+
 void CefDownloadManagerDelegateImpl::OnDownloadDestroyed(DownloadItem* item) {
   item->RemoveObserver(this);
 
