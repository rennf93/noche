{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
